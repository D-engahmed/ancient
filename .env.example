API_URL=http://localhost:3000

POSTGRES_USER=ancient
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_DB=ancient
POSTGRES_PORT=5432
ADMINER_PORT=8080
DATABASE_URL=postgresql://ancient:change-this-development-password@localhost:5432/ancient?schema=public

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
JWT_SECRET=jwt-secret
ANCIENT_CONNECTION_KEY_SECRET=
ANCIENT_BYOK_REQUESTS_PER_MINUTE=60

# --- ANCIENT 2.0: free/local model lane (optional) ---
# Used by free-first model routing, `model: cheap` subagents, and /compact.
# OpenRouter free tier example:
#   ANCIENT_FREE_MODEL_BASE_URL=https://openrouter.ai/api/v1
#   ANCIENT_FREE_MODEL_ID=mistralai/devstral-2512:free
#   ANCIENT_FREE_MODEL_API_KEY=sk-or-...
# Fully local (Ollama) example — no key needed:
#   ANCIENT_FREE_MODEL_BASE_URL=http://localhost:11434/v1
#   ANCIENT_FREE_MODEL_ID=qwen3:14b
ANCIENT_FREE_MODEL_BASE_URL=
ANCIENT_FREE_MODEL_ID=
ANCIENT_FREE_MODEL_API_KEY=

# --- OpenRouter model-level fallback (optional) ---
# Some `:free` models are served by a single upstream provider. When that
# provider rate-limits (HTTP 429), there is no other provider to route
# around, so the request just fails — this is the
# "z-ai/glm-5.2:free is temporarily rate-limited upstream" error. Setting
# this makes ANY OpenRouter-routed call (the free lane above, `model: cheap`
# subagents, and any BYOK connection pointed at openrouter.ai) pass a
# `models` fallback array, so OpenRouter tries the next model — possibly on
# a different provider entirely — instead of hard-failing.
# Comma-separated OpenRouter model IDs. Pick 1-3 other `:free` models you're
# comfortable falling back to; verify they're still free at
# https://openrouter.ai/models?fmt=table&order=top-weekly&supported_parameters=free
# since the free-tier roster rotates.
# Example:
#   ANCIENT_OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,qwen/qwen3-coder:free
ANCIENT_OPENROUTER_FALLBACK_MODELS=

# --- Tuning (defaults shown) ---
# ANCIENT_CHAT_TIMEOUT_MS=300000
# ANCIENT_MAX_TOOL_STEPS=50
# ANCIENT_MAX_RESPONSE_CHARS=200000
# How long a model stays on the "fail fast" cooldown after a 429, before the
# next turn is allowed to try it again (see rate-limit-breaker.ts).
# ANCIENT_RATE_LIMIT_COOLDOWN_MS=60000
#
# Rate-limit graceful fallback: when your explicitly-selected custom/free BYOK
# model is on cooldown after a 429, the turn auto-falls-back to the next healthy
# model instead of erroring — configured modelRouting.freeModel first, then the
# builtin default (see lib/fallback.ts + selectHealthyFallbackModel in chat.ts).
# It only throws the 429 error when EVERY candidate is also on cooldown.
