{
  "$comment": "Copy to .mcp.json in your project root (or ~/.ancient/.mcp.json for user-global). Tools appear as mcp__<name>__<tool>.",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_..." }
    },
    "remote-example": {
      "url": "https://example.com/mcp"
    }
  }
}
