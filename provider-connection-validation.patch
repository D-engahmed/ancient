+// Best-effort extraction of model ids from a /models (or /v1/models) list
+// response. Both the OpenAI-compatible shape and Anthropic's Models API
+// return `{ data: [{ id, ... }, ...] }`, but third-party / local servers
+// (Ollama, LM Studio, vLLM, arbitrary "custom" endpoints) aren't guaranteed
+// to match that shape. Returns null when the ids can't be reliably read,
+// so callers can fail open rather than false-reject a working connection.
+function extractModelIds(body: unknown): string[] | null {
+    if (!body || typeof body !== "object" || !("data" in body)) return null;
+    const data = (body as { data?: unknown }).data;
+    if (!Array.isArray(data)) return null;
+
+    const ids = data
+        .map((entry) => (entry && typeof entry === "object" && "id" in entry ? (entry as { id?: unknown }).id : undefined))
+        .filter((id): id is string => typeof id === "string" && id.length > 0);
+
+    return ids.length > 0 ? ids : null;
+}
