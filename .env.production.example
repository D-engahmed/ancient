# Production secrets/configuration. Store this file outside source control.
POSTGRES_USER=ancient
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ancient

# Required by the application
CLERK_SECRET_KEY=REPLACE_ME
CLERK_PUBLISHABLE_KEY=REPLACE_ME
ANCIENT_CONNECTION_KEY_SECRET=REPLACE_WITH_32_BYTE_SECRET
ANCIENT_PLATFORM_API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY

# Provider credentials are deployment-specific.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Security: keep false for hosted SaaS. Only enable for a trusted self-hosted
# deployment where users are allowed to reach operator-owned local model servers.
ANCIENT_ALLOW_LOCAL_PROVIDER_ENDPOINTS=false

# Optional platform spend ceiling.
# ANCIENT_COST_CEILING_USD=100

# Optional diagnostics. Keep disabled in production.
ANCIENT_DEBUG_ERRORS=0
