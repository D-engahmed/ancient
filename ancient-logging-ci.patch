+name: CI
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  typecheck-and-build:
+    runs-on: ubuntu-latest
+    env:
+      # prisma generate runs in postinstall; without a DATABASE_URL set,
+      # prisma.config.ts still allows `generate` to proceed (see its
+      # comment), but set a dummy one so nothing downstream that reads
+      # process.env.DATABASE_URL blows up unexpectedly in CI.
+      DATABASE_URL: "postgresql://ci:ci@localhost:5432/ci"
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: oven-sh/setup-bun@v2
+        with:
+          bun-version: latest
+
+      - name: Install dependencies
+        run: bun install
+
+      - name: Typecheck (all packages)
+        run: bun run typecheck
+
+      - name: Build cli
+        run: bun run --cwd packages/cli build
+
+      - name: Build server
+        run: bun run --cwd packages/server build
+
+  # Placeholder — wire this up once tests exist. Left as a visibly failing
+  # no-op rather than silently absent, so "we have a test job" doesn't
+  # quietly mean "we have zero tests and nobody's tracking that."
+  # test:
+  #   runs-on: ubuntu-latest
+  #   steps:
+  #     - run: echo "no tests yet" && exit 1
