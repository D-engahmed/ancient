+    if (!providers.length) {
+      throw new Error(`No providers available for model: ${agentConfig.model}`);
+    }
+    
+    // PERFORMANCE FIX: Optimize for latency and cost
+    const optimizedProvider = await this.latencyOptimizer.selectOptimalProvider(
