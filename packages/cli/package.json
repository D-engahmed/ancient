{
  "name": "@ANCIENT/cli",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "version": "3.1.0",
  "description": "ANCIENT terminal coding agent client.",
  "repository": "https://github.com/D-engahmed/ancient",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ANCIENT": "./bin/ANCIENT"
  },
  "scripts": {
    "prepack": "bun run build",
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build src/main.tsx --outdir dist --target bun",
    "build:standalone": "bun build src/main.tsx --compile --outfile dist/ANCIENT",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ANCIENT/server": "workspace:*",
    "@types/bun": "latest",
    "@types/react": "^19.2.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ANCIENT/shared": "workspace:*",
    "@ANCIENT/infrastructure": "workspace:*",
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "ai": "^7.0.108",
    "@ai-sdk/react": "^4.0.70",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.13.8",
    "open": "^11.0.4",
    "opentui-spinner": "^0.0.6",
    "pretty-ms": "^9.3.0",
    "react": "^19.2.4",
    "react-router": "^7.14.0",
    "zod": "^4.3.6"
  },
  "license": "SEE LICENSE IN LICENSE"
}
