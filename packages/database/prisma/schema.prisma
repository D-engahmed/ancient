generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  title     String
  cwd       String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  messages  Message[]
}

model Message {
  id        String        @id @default(uuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      Role
  status    MessageStatus
  modelKind String
  modelRef  String
  content   String
  parts     Json?
  mode      Mode
  duration  Int?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

model ProviderConnection {
  id                  String    @id @default(uuid())
  userId              String
  label               String
  protocol            String
  baseUrl             String
  modelId             String
  encryptedKey        Bytes
  keyLastFour         String
  isValid             Boolean   @default(false)
  lastValidatedAt     DateTime?
  lastValidationError String?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([userId, createdAt])
}

model ModelProvider {
  id             String              @id
  label          String
  protocol       String
  defaultBaseUrl String
  isReseller     Boolean             @default(false)
  catalogEntries ModelCatalogEntry[]
}

model ModelCatalogEntry {
  id            String        @id @default(uuid())
  providerId    String
  provider      ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId       String
  label         String
  contextWindow Int           @default(0)
  isActive      Boolean       @default(true)

  @@unique([providerId, modelId])
  @@index([providerId])
}