generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  title     String
  cwd       String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  messages  Message[]
}

model Message {
  id        String        @id @default(uuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      Role
  status    MessageStatus
  modelKind String
  modelRef  String
  content   String
  parts     Json?
  mode      Mode
  duration  Int?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

model ProviderConnection {
  id                  String    @id @default(uuid())
  userId              String
  label               String
  protocol            String
  baseUrl             String
  modelId             String
  encryptedKey        Bytes
  keyLastFour         String
  isValid             Boolean   @default(false)
  lastValidatedAt     DateTime?
  lastValidationError String?
  lastUsedAt          DateTime?
  createdAt           DateTime  @default(now())

  // ---- Quota tracking (learned, not configured) ----
  // Populated from the provider's own 429 response the first time one is
  // seen (see packages/server/src/lib/quota.ts). All nullable: until a
  // rate-limit response has actually been observed, the app has no
  // trustworthy number to show and should say so rather than guess.
  lastKnownQuotaLimit         Int?      // e.g. 20 (requests) — parsed from the provider's quota error
  lastKnownQuotaWindowSeconds Int?      // e.g. 86400 for a daily quota — inferred from the quotaId text
  lastKnownQuotaResetAt       DateTime? // best-effort: now + the provider's retryDelay at time of the 429
  lastKnownQuotaMetric        String?   // e.g. "generate_content_free_tier_requests" — shown for context

  @@index([userId, createdAt])
}

model ModelProvider {
  id             String              @id
  label          String
  protocol       String
  defaultBaseUrl String
  isReseller     Boolean             @default(false)
  catalogEntries ModelCatalogEntry[]
}

model ModelCatalogEntry {
  id            String        @id @default(uuid())
  providerId    String
  provider      ModelProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId       String
  label         String
  contextWindow Int           @default(0)
  isActive      Boolean       @default(true)

  @@unique([providerId, modelId])
  @@index([providerId])
}


// ============================================================================
// Agent System Models
// ============================================================================

model AgentTeam {
  id                String   @id @default(uuid())
  name              String
  description       String?
  coordinatorId     String
  protocol          String   // JSON string of ProtocolConfig
  maxParallelAgents Int      @default(5)
  sharedContext     Boolean  @default(true)
  checkpointEnabled Boolean  @default(true)
  fallbackStrategy  String   // JSON string
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  agents            AgentDefinition[]
  executions        AgentExecution[]
}

model AgentDefinition {
  id                 String    @id @default(uuid())
  teamId             String
  team               AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name               String
  role               String
  description        String?
  systemPrompt       String?   @db.Text
  capabilities       String[]  @default([])
  tools              String[]  @default([])
  backend            String    // JSON string of BackendConfig
  fallbackBackends   String[]  @default([]) // JSON strings
  maxDelegationDepth Int       @default(0)
  canDelegateTo      String[]  @default([])
  parentId           String?
  metadata           String?   // JSON string
}

model AgentExecution {
  id           String   @id @default(uuid())
  teamId       String
  team         AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  taskId       String
  status       String   @default("running") // running, paused, completed, failed, cancelled
  currentAgent String?
  progress     Int      @default(0)
  result       String?  // JSON string of TaskResult
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  
  messages     AgentMessage[]
  checkpoints  AgentCheckpoint[]
}

model AgentMessage {
  id          String   @id @default(uuid())
  executionId String
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  senderId    String
  senderRole  String
  senderName  String
  recipientId String?
  content     String   @db.Text
  messageType String   @default("chat")
  metadata    String?  // JSON string
  timestamp   DateTime @default(now())
}

model AgentCheckpoint {
  id            String   @id @default(uuid())
  executionId   String
  execution     AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agentId       String
  taskId        String
  contextSnapshot String @db.Text // JSON string of SharedContext
  reason        String
  timestamp     DateTime @default(now())
}