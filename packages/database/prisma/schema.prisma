generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  title     String
  cwd       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      Role
  status    MessageStatus
  modelKind String
  modelRef  String
  content   String
  parts     Json?
  mode      Mode
  duration  Int?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ProviderConnection {
  id                  String   @id @default(uuid())
  userId              String
  label               String
  protocol            String
  baseUrl             String
  modelId             String
  encryptedKey        Bytes
  keyLastFour         String
  isValid             Boolean  @default(true)
  lastValidatedAt     DateTime?
  lastValidationError String?
  lastUsedAt          DateTime?
  createdAt           DateTime @default(now())

  @@index([userId])
}

model ModelProvider {
  id             String
  label          String
  protocol       String
  defaultBaseUrl String
  isReseller     Boolean            @default(false)
  models         ModelCatalogEntry[]

  @@id([id])
}

model ModelCatalogEntry {
  id            String        @id @default(cuid())
  providerId    String
  provider      ModelProvider @relation(fields: [providerId], references: [id])
  modelId       String
  label         String
  contextWindow Int
  isActive      Boolean       @default(true)
  updatedAt     DateTime      @updatedAt

  @@unique([providerId, modelId])
}